# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- SAFETY -----------------------------------------------------------------
# While true, NOTHING is emailed. The system prints what it *would* send.
# Set to false ONLY when you are ready to send for real.
DRY_RUN=true

# Hard cap on how many outbound emails (openers + follow-ups) go out per day.
# Keep this low on a personal Gmail (30-40) to protect deliverability.
MAX_SENDS_PER_DAY=30

# --- ANTHROPIC (personalization + reply classification) ---------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxx
# Cheap + fast is right for this volume. Change if you want.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- YOUTUBE (prospect discovery) -------------------------------------------
# API key from a Google Cloud project with "YouTube Data API v3" enabled.
YOUTUBE_API_KEY=
# Comma-separated search terms used to discover creator channels.
YOUTUBE_SEARCH_TERMS=roblox roleplay,roblox cinematic,roblox gameplay
# Only keep discovered channels inside this subscriber band.
MIN_SUBSCRIBERS=20000
# Raised from 500000 so established channels are discovered at all. The cap
# still exists so discovery doesn't queue 20M-sub channels that will never
# answer but still consume slots under MAX_SENDS_PER_DAY.
MAX_SUBSCRIBERS=5000000

# --- fast track -------------------------------------------------------------
# At or above this size, a channel skips the growth gate entirely — it's
# already established, so waiting two snapshot cycles to email it is two weeks
# of nothing. It must ALSO have uploaded within ACTIVE_UPLOAD_DAYS: a big
# dormant channel is worse than a small live one.
FASTTRACK_SUBSCRIBERS=500000
ACTIVE_UPLOAD_DAYS=30

# --- growth -----------------------------------------------------------------
# Window used to decide "is this channel growing". Needs 2+ snapshots inside
# the window, and snapshots are weekly, so a newly discovered channel becomes
# promotable after about two weeks.
GROWTH_WINDOW_DAYS=30
# How long before the weekly digest re-asks about a channel you never resolved.
CANDIDATE_REASK_DAYS=30

# --- API --------------------------------------------------------------------
# REQUIRED for /stats, /add and /import. Without it the API refuses to start
# (the scheduler still runs) — these routes write into prospects, and anything
# there gets cold-emailed from your Gmail, so an open endpoint is a spam relay.
# Generate one with:  openssl rand -hex 32
API_KEY=

# --- quota ------------------------------------------------------------------
# Channels resolve via channels.list in batches (~1 unit per 50). Rows with no
# stored channel_id fall back to search.list at 100 units EACH, so the fallback
# is capped — uncapped, a few hundred id-less rows eat the whole daily quota.
CHANNEL_BATCH_SIZE=50
MAX_SEARCH_FALLBACKS=20

# --- GMAIL ------------------------------------------------------------------
# Path to the OAuth client secrets you download from Google Cloud Console
# (Desktop app credentials). The token is cached in token.json after first run.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
# The name that appears on the "From" line. The address is read from the
# authenticated account automatically.
FROM_NAME=Laurenz Holzhausen

# --- BRAND / CONTENT --------------------------------------------------------
STUDIO_NAME=LockedIn Studio
# A real postal address is legally required in commercial email (CAN-SPAM).
STUDIO_ADDRESS=LockedIn Studio, <your street>, <city>, <country>
# Link creators can look at for proof of work. This is the single biggest
# lever on reply quality — make it good.
PORTFOLIO_URL=https://your-portfolio-link.example

# --- STORAGE ----------------------------------------------------------------
DB_PATH=outreach.db
